<Window x:Class="XinDong.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="468"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- 弹窗本体：圆角 + 弥散阴影 -->
    <Border Margin="18" CornerRadius="18" Background="White" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.24" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />

            <TextBlock x:Name="MessageText" FontSize="13" LineHeight="21" Margin="0,10,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="PrimaryButton" Content="知道了" Height="36" MinWidth="96"
                        Style="{StaticResource GhostButton}" Click="Primary_Click" />
                <Button x:Name="SecondaryButton" Content="含泪下班" Height="36" MinWidth="96"
                        Margin="10,0,0,0" Style="{StaticResource DangerButton}"
                        Click="Secondary_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
