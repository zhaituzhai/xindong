<Window x:Class="XinDong.Views.ClockOutTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认下班时间"
        Width="430"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- iOS 风格滚轮列表 -->
        <Style x:Key="WheelListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
        </Style>

        <Style x:Key="WheelItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#A1A1A6" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="23" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="WheelItemTemplate">
            <TextBlock Text="{Binding Text}"
                       FontFamily="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=FontFamily}"
                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=FontSize}"
                       FontWeight="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=FontWeight}"
                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                       TextAlignment="Center" />
        </DataTemplate>
    </Window.Resources>

    <Border Margin="18" CornerRadius="18" Background="White" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.24" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="🕐 确认下班时间" FontSize="17" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}" />
            <TextBlock x:Name="DateText" FontSize="12" Margin="0,7,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock x:Name="RangeText" FontSize="11" Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <TextBlock Text="上下滑动选择时间（只改时间不改日期）" Style="{StaticResource Caption}"
                       Margin="2,16,0,6" />

            <Border Background="#F5F5F7" BorderBrush="#E5E5EA" BorderThickness="1"
                    CornerRadius="14" Height="160" ClipToBounds="True">
                <Grid>
                    <!-- 中间选中带：跟随薪动的浅蓝强调色，不使用 iOS 深色选择条 -->
                    <Border Height="40" Margin="18,0" Background="White"
                            BorderBrush="#D6E4FF" BorderThickness="1"
                            CornerRadius="10" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08" Color="#007AFF" />
                        </Border.Effect>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="HourList" Grid.Column="0"
                                 Style="{StaticResource WheelListStyle}"
                                 ItemContainerStyle="{StaticResource WheelItemStyle}"
                                 ItemTemplate="{StaticResource WheelItemTemplate}"
                                 SelectionChanged="Wheel_SelectionChanged"
                                 PreviewMouseWheel="Wheel_PreviewMouseWheel"
                                 PreviewMouseLeftButtonDown="Wheel_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="Wheel_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="Wheel_PreviewMouseLeftButtonUp" />

                        <TextBlock Grid.Column="1" Text=":" FontSize="22" FontWeight="SemiBold"
                                   Foreground="#C7C7CC" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />

                        <ListBox x:Name="MinuteList" Grid.Column="2"
                                 Style="{StaticResource WheelListStyle}"
                                 ItemContainerStyle="{StaticResource WheelItemStyle}"
                                 ItemTemplate="{StaticResource WheelItemTemplate}"
                                 SelectionChanged="Wheel_SelectionChanged"
                                 PreviewMouseWheel="Wheel_PreviewMouseWheel"
                                 PreviewMouseLeftButtonDown="Wheel_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="Wheel_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="Wheel_PreviewMouseLeftButtonUp" />
                    </Grid>

                    <!-- 上下淡出，弱化首尾滚动感 -->
                    <Border Height="26" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFF5F5F7" Offset="0" />
                                <GradientStop Color="#00F5F5F7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Height="26" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00F5F5F7" Offset="0" />
                                <GradientStop Color="#FFF5F5F7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="现在" Style="{StaticResource GhostButton}"
                        Height="30" Padding="14,0" Click="Now_Click" />
                <Button x:Name="NormalEndButton" Content="按正常下班" Style="{StaticResource GhostButton}"
                        Height="30" Padding="14,0" Margin="8,0,0,0" Click="NormalEnd_Click" />
            </StackPanel>

            <TextBlock Text="最晚只能选到当前时间，超过会自动回到当前时间；选择更早时间会按该时间重新结算，之后的时间不补算。"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,7,0,0" />

            <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{StaticResource RedBrush}"
                       Margin="2,9,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Height="36" MinWidth="88"
                        Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Content="✅ 确认下班" Height="36" MinWidth="120" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
