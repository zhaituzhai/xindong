<Window x:Class="XinDong.Views.EmergencyCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="老板夺命Call"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Margin="18" CornerRadius="18" Background="White" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.26" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="🚨 老板夺命Call" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource RedBrush}" />
            <TextBlock Text="下班 / 休假被临时抓回，这次怎么算？"
                       FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <Border Margin="0,16,0,0" Padding="14" CornerRadius="12" Background="#FFF4F4">
                <RadioButton x:Name="UnpaidRadio" GroupName="CompensationMode" IsChecked="True"
                             VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="纯义务白嫖（无加班费）" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="基础工资锁死；按 2.0×（工作日下班后）/ 3.0×（周末节假日）计入老板少给账本。"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </RadioButton>
            </Border>

            <Border Margin="0,10,0,0" Padding="14" CornerRadius="12" Background="#F7F7FA">
                <RadioButton x:Name="FixedRadio" GroupName="CompensationMode"
                             VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="老板良心发现 · 固定单次补贴" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="结束时一次性计入今日已到手工资，不计入亏损。"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="FixedSubsidyBox" Text="100" Width="130"
                                     Style="{StaticResource InputBox}"
                                     IsEnabled="{Binding IsChecked, ElementName=FixedRadio}" />
                            <TextBlock Text="元" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
            </Border>

            <Border Margin="0,10,0,0" Padding="14" CornerRadius="12" Background="#F7F7FA">
                <RadioButton x:Name="HourlyRadio" GroupName="CompensationMode"
                             VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="老板良心发现 · 按实际加班时薪折算" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="期间今日已到手工资实时跳动，不累计亏损。"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="HourlyRateBox" Text="50" Width="130"
                                     Style="{StaticResource InputBox}"
                                     IsEnabled="{Binding IsChecked, ElementName=HourlyRadio}" />
                            <TextBlock Text="元 / 小时" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
            </Border>

            <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{StaticResource RedBrush}"
                       Margin="2,10,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Height="36" MinWidth="88"
                        Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Content="🚨 开始被迫营业" Height="36" MinWidth="150" Margin="10,0,0,0"
                        Style="{StaticResource DangerButton}" Click="Start_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
