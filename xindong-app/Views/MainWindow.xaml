                        </Grid>

                        <!-- ============ 页面 3：血泪账本 ============ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsPageLedger, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="26,20,26,24">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="血泪账本" Style="{StaticResource H1}" />
                                        <TextBlock Text="每一天的收益、摸鱼、加班与抹零，都记在这里，跑不掉。"
                                                   Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="📤 导出 CSV" Style="{StaticResource GhostButton}"
                                                Click="ExportCsv_Click" />
                                        <Button Content="📂 数据目录" Style="{StaticResource GhostButton}"
                                                Margin="8,0,0,0" Click="OpenDataFolder_Click" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16">
                                    <StackPanel>
                                        <!-- 表头 -->
                                        <Grid Margin="6,0,6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="日期" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="正常收益" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="2" Text="摸鱼白嫖" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="3" Text="加班血亏" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="4" Text="抹零损失" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="5" Text="当日净值" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource Caption}" />
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource HairLineBrush}" />

                                        <ListBox ItemsSource="{Binding History}" Height="520"
                                                 BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Margin="0,4,0,0">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource HairLineBrush}"
                                                            BorderThickness="0,0,0,1" Padding="6,9">
                                                        <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="104" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="104" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Date}" Style="{StaticResource LedgerCell}"
                                                                       FontFamily="{StaticResource MonoFont}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding NormalDisplay}"
                                                                       Style="{StaticResource LedgerCell}"
                                                                       FontFamily="{StaticResource MonoFont}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding SlackingDisplay}"
                                                                       Style="{StaticResource LedgerCell}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       Foreground="{StaticResource GreenBrush}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding OvertimeDisplay}"
                                                                       Style="{StaticResource LedgerCell}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       Foreground="{StaticResource RedBrush}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding RoundingDisplay}"
                                                                       Style="{StaticResource LedgerCell}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       Foreground="{StaticResource OrangeBrush}" />
                                                            <TextBlock Grid.Column="5" Text="{Binding HedgeDisplay}"
                                                                       Style="{StaticResource LedgerCell}"
                                                                       FontFamily="{StaticResource MonoFont}" />
                                                            <TextBlock Grid.Column="6" Text="{Binding FlagDisplay}"
                                                                       Style="{StaticResource LedgerCell}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding EmergencyCallDisplay}"
                                                                   FontSize="11" Margin="6,5,0,0"
                                                                   Foreground="{StaticResource RedBrush}"
                                                                   Visibility="{Binding HasEmergencyCall, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="还没有历史记录。今天下班确认后，这里就会留下第一条「血泪」。" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="6,20,0,10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ 页面 4：设置 ============ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsPageSettings, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="26,20,26,24">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="设置" Style="{StaticResource H1}" />
                                        <TextBlock Text="所有配置写入 exe 同目录的 xindong_config.json，随文件夹一起迁移。"
                                                   Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Content="💾 保存并应用" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding SaveSettingsCommand}"
                                            Style="{StaticResource PrimaryButton}" Width="132" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左列 -->
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="💼 薪资与排班" Style="{StaticResource H2}" />

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="计薪模式" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <ComboBox Style="{StaticResource InputCombo}"
                                                                  ItemsSource="{Binding SalaryModeOptions}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedItem="{Binding SelectedSalaryMode, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="薪资金额（元 / 元每小时）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}"
                                                                 LostFocus="SalaryField_LostFocus"
                                                                 Text="{Binding Config.SalaryAmount, Mode=TwoWay}" />
                                                        <Button Content="保存薪资" Style="{StaticResource GhostButton}"
                                                                Height="28" Margin="0,6,0,0" Padding="12,0"
                                                                HorizontalAlignment="Left"
                                                                Command="{Binding SaveSalaryOnlyCommand}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Text="休息制度（决定折算月计薪天数 D）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                    <ComboBox Style="{StaticResource InputCombo}"
                                                              ItemsSource="{Binding RestOptions}"
                                                              DisplayMemberPath="Name"
                                                              SelectedItem="{Binding SelectedRest, Mode=TwoWay}" />
                                                </StackPanel>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="上班时间" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}"
                                                                 LostFocus="TimeField_LostFocus"
                                                                 Text="{Binding Config.WorkStart, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="下班时间" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}"
                                                                 LostFocus="TimeField_LostFocus"
                                                                 Text="{Binding Config.WorkEnd, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="业务日切 = 上班时间 − 1 小时；跨 00:00 的通宵加班 / 夺命Call 会持续累计，到日切点才封账。"
                                                           Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                           Margin="2,6,0,0" />

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="午休开始" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}"
                                                                 LostFocus="TimeField_LostFocus"
                                                                 Text="{Binding Config.LunchStart, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="午休结束" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}"
                                                                 LostFocus="TimeField_LostFocus"
                                                                 Text="{Binding Config.LunchEnd, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="每日标准有效工时 H（自动）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <Border Height="34" Background="{StaticResource SoftFillBrush}"
                                                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                                                CornerRadius="9" ToolTip="由上班、下班与午休时间自动折算">
                                                            <TextBlock Text="{Binding StandardHoursDisplay}"
                                                                       FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                                       VerticalAlignment="Center" Margin="10,0"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="每月发薪日" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.PayDay, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="薪资换算（随薪资、D、H 自动更新）" Style="{StaticResource Caption}" Margin="2,12,0,6" />
                                                <Border Background="#F8F8FB" BorderBrush="{StaticResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="日薪" Style="{StaticResource Caption}" />
                                                            <TextBlock Text="{Binding DailyWageText}" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="时薪" Style="{StaticResource Caption}" />
                                                            <TextBlock Text="{Binding HourlyWageText}" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="分薪" Style="{StaticResource Caption}" />
                                                            <TextBlock Text="{Binding MinuteWageText}" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="秒薪" Style="{StaticResource Caption}" />
                                                            <TextBlock Text="{Binding SecondWageText}" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="16" FontWeight="Bold" Margin="0,2,0,0"
                                                                       Foreground="{StaticResource AccentBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border Background="#F5F5F7" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ScheduleSummaryText}" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        <Button Content="修改本周大 / 小周" Command="{Binding ChangeBigSmallWeekCommand}"
                                                                Style="{StaticResource GhostButton}" Height="28" Padding="10,0"
                                                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                                                Visibility="{Binding IsBigSmallWeek, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 右列 -->
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="🏠 生存成本与熔断" Style="{StaticResource H2}" />
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="月房租水电（元）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.MonthlyRent, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="日均通勤 + 餐饮（元）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.DailyCommuteFood, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Text="月度白嫖忍耐上限（元，仅用于月 / 年熔断，不影响今日净赚）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.MonthlyToleranceLimit, Mode=TwoWay}" />
                                                </StackPanel>
                                                <TextBlock Text="每日生存回本线 = 月房租水电 ÷ 30 + 日均通勤餐饮，回本前显示「替房东打工」进度。"
                                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,8,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="🩸 义务加班倍率" Style="{StaticResource H2}" />
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="平日基础倍率" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.OvertimeRateNormal, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="平日超时倍率" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.OvertimeRateNormalLate, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="节假日基础倍率" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.OvertimeRateHoliday, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="节假日超时倍率" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.OvertimeRateHolidayLate, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="平日切换门槛（小时）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.NormalOvertimeStageHours, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="节假日切换门槛（小时）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Config.HolidayOvertimeStageHours, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Margin="0,12,0,0">
                                                    <CheckBox IsChecked="{Binding Config.UseCustomOvertimeBase, Mode=TwoWay}"
                                                              Click="TimeField_LostFocus"
                                                              HorizontalContentAlignment="Stretch"
                                                              FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                              Margin="2,0,0,0">
                                                        <TextBlock Text="加班费按合同基本底薪 / 当地最低工资计算（默认关闭，关闭时按全额月薪折算）"
                                                                   TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <TextBlock Text="加班基准底薪（元/月）"
                                                               Style="{StaticResource Caption}" Margin="2,9,0,4" />
                                                    <TextBox Style="{StaticResource InputBox}" Width="180"
                                                             HorizontalAlignment="Left"
                                                             IsEnabled="{Binding Config.UseCustomOvertimeBase}"
                                                             LostFocus="TimeField_LostFocus"
                                                             Text="{Binding Config.OvertimeBaseSalary, Mode=TwoWay}" />
                                                    <TextBlock Text="{Binding OvertimeBaseHourlyDisplay}"
                                                               FontSize="11" Margin="2,7,0,0"
                                                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="加班基数时薪 = 底薪 ÷（月计薪天数 D × 每日工时 H）；只影响义务加班与夺命Call亏损，不影响正常工资。"
                                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,6,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="🕶️ 老板键与数据" Style="{StaticResource H2}" />
                                                <TextBlock Text="老板键行为" Style="{StaticResource Caption}" Margin="2,12,0,4" />
                                                <ComboBox Style="{StaticResource InputCombo}"
                                                          ItemsSource="{Binding BossOptions}"
                                                          DisplayMemberPath="Name"
                                                          SelectedItem="{Binding SelectedBossMode, Mode=TwoWay}" />
                                                <TextBlock Text="选择 B1 / B2 会立即在灵动岛预览暗语伪装；按老板键（Alt + Z，被占用时自动降级）才隐藏主窗口。"
                                                           Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="全局热键：默认 Alt + Z；被其它软件占用时自动降级（实际组合见下方）"
                                                           Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding HotkeyStatusText}"
                                                           FontSize="11" Margin="2,4,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="数据保存在 exe 同级目录：xindong_config.json / xindong_ledger.json"
                                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,6,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="📂 打开数据目录" Style="{StaticResource GhostButton}"
                                                            Height="32" Click="OpenDataFolder_Click" />
                                                    <Button Content="📤 导出 CSV" Style="{StaticResource GhostButton}"
                                                            Height="32" Margin="8,0,0,0" Click="ExportCsv_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 启动与运行 -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ 启动与运行" Style="{StaticResource H2}" />
                                        <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                                            <CheckBox Content="开机自动启动（登录 Windows 后自动运行薪动）"
                                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                                      FontSize="12" VerticalAlignment="Center" />
                                            <Button Content="生成启动项文件" Style="{StaticResource GhostButton}"
                                                    Height="28" Padding="10,0" Margin="12,0,0,0"
                                                    Click="GenerateStartupScripts_Click" />
                                        </StackPanel>
                                        <TextBlock Text="优先写当前用户启动项；如果系统权限拦截导致无法勾选，可点右侧生成 .reg 文件，双击导入启用。"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,7,0,0" />
                                        <TextBlock Text="{Binding SettingsMessage}" FontSize="11" TextWrapping="Wrap"
                                                   Margin="2,5,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSettingsMessage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 节假日与调休：可视化排班月历 -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="🏖️ 节假日与调休" Style="{StaticResource H2}" />
                                                <TextBlock Text="点击日期切换上班 / 休息；红色为法定停计，蓝色为补班，浅灰为常规休息。"
                                                           Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Border Background="#F5F5F7" CornerRadius="8" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="‹" Command="{Binding PrevHolidayYearCommand}"
                                                                Style="{StaticResource GhostButton}" Width="26" Height="26"
                                                                Padding="0" />
                                                        <TextBlock Text="{Binding HolidayYearLabel}" FontSize="12" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" Margin="6,0" />
                                                        <Button Content="›" Command="{Binding NextHolidayYearCommand}"
                                                                Style="{StaticResource GhostButton}" Width="26" Height="26"
                                                                Padding="0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F5F5F7" CornerRadius="8" Padding="2" Margin="8,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="‹" Command="{Binding PrevHolidayMonthCommand}"
                                                                Style="{StaticResource GhostButton}" Width="26" Height="26"
                                                                Padding="0" />
                                                        <TextBlock Text="{Binding HolidayMonthLabel}" FontSize="12" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" Margin="6,0" />
                                                        <Button Content="›" Command="{Binding NextHolidayMonthCommand}"
                                                                Style="{StaticResource GhostButton}" Width="26" Height="26"
                                                                Padding="0" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="{Binding HolidaySyncButtonText}"
                                                        Command="{Binding SyncHolidaysCommand}"
                                                        Style="{StaticResource PrimaryButton}" Height="32"
                                                        Padding="12,0" Margin="10,0,0,0" />
                                                <Button Content="重置本年" Command="{Binding ResetHolidaysCommand}"
                                                        Style="{StaticResource GhostButton}" Height="32"
                                                        Padding="10,0" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{Binding HolidayQuotaText}" FontSize="11"
                                                       Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding HolidaySummaryText}" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>

                                        <UniformGrid Columns="7" Margin="0,10,0,3">
                                            <TextBlock Text="一" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="二" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="三" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="四" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="五" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="六" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="日" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                        </UniformGrid>

                                        <ItemsControl ItemsSource="{Binding HolidayDays}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button x:Name="Cell" Style="{StaticResource HolidayDayButton}"
                                                            Background="{Binding CellBackground}"
                                                            Command="{Binding DataContext.ToggleHolidayDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding Tooltip}">
                                                        <Grid>
                                                            <TextBlock x:Name="DayText" Text="{Binding DayText}" FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{Binding DayForeground}"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                       Margin="8,7,0,0" />
                                                            <Border Background="{Binding BadgeBackground}" CornerRadius="7"
                                                                    Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Margin="0,6,6,0"
                                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold"
                                                                           Foreground="{Binding BadgeForeground}" />
                                                            </Border>
                                                            <Border x:Name="TodayPill" Background="{StaticResource AccentBrush}"
                                                                    CornerRadius="7" Padding="5,1"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Margin="0,0,6,6"
                                                                    Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="今天" FontSize="9" FontWeight="Bold"
                                                                           Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                            <Setter TargetName="Cell" Property="Visibility" Value="Hidden" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter TargetName="Cell" Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                                                            <Setter TargetName="DayText" Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Margin="0,8,0,0">
                                            <WrapPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource RedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="红休：法定 / 停计" FontSize="10" Margin="5,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="蓝班：补班 / 强制上班" FontSize="10" Margin="5,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="7" Height="7" CornerRadius="2" Background="#E5E5EA"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Text="浅灰：常规休息" FontSize="10" Margin="5,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding HolidaySyncMessage}" FontSize="11" Margin="0,8,0,0"
                                                   Foreground="{Binding HolidaySyncBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasHolidaySyncMessage, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <!-- 云端排行 -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="☁️ 云端排行" Style="{StaticResource H2}" />
                                        <CheckBox Content="加入排行（上报数据参与日 / 周榜对比）"
                                                  Style="{StaticResource ChipCheckBox}"
                                                  IsChecked="{Binding Config.JoinLeaderboard, Mode=TwoWay}"
                                                  Margin="0,10,0,0" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="服务器地址" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                <TextBox Style="{StaticResource InputBox}"
                                                         Text="{Binding Config.ServerBaseUrl, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="花名（榜单展示用）" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                                <TextBox Style="{StaticResource InputBox}"
                                                         Text="{Binding Config.Nickname, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="开启后将在保存设置 / 退出时上报数据；离线时静默降级为纯本地，不阻断任何功能。花名留空则榜单显示设备号前 6 位。"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- 保存条 -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SettingsPreviewText}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SettingsMessage}" FontSize="12" Margin="0,6,0,0"
                                                       Foreground="{StaticResource GreenBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSettingsMessage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="保存并应用" Width="130"
                                                Command="{Binding SaveSettingsCommand}"
                                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ 页面 5：排行 ============ -->
                        <Grid Visibility="{Binding IsPageRank, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="26,20,26,24">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="🏆 排行" Style="{StaticResource H1}" />
                                            <TextBlock Text="{Binding Rank.StatusText}" Style="{StaticResource Caption}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="{StaticResource NavBgBrush}" CornerRadius="9" Padding="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource SegRadio}" GroupName="rankscope"
                                                                 Content="📅 日"
                                                                 IsChecked="{Binding Rank.IsScopeDaily, Mode=OneWay}"
                                                                 Command="{Binding Rank.SetScopeCommand}" CommandParameter="daily" />
                                                    <RadioButton Style="{StaticResource SegRadio}" GroupName="rankscope"
                                                                 Content="📊 周"
                                                                 IsChecked="{Binding Rank.IsScopeWeekly, Mode=OneWay}"
                                                                 Command="{Binding Rank.SetScopeCommand}" CommandParameter="weekly" />
                                                </StackPanel>
                                            </Border>
                                            <Button Content="🔄 刷新" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                                    Command="{Binding Rank.RefreshCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Text="指标" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                        <ComboBox Style="{StaticResource InputCombo}"
                                                  ItemsSource="{Binding Rank.Metrics}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{Binding Rank.SelectedMetric, Mode=TwoWay}" />
                                    </StackPanel>

                                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                        <TextBlock Text="{Binding Rank.MyRankText}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <ItemsControl ItemsSource="{Binding Rank.Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="56" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                                    <Setter Property="FontSize" Value="14" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                    <Setter Property="Text" Value="{Binding Rank, StringFormat='No. {0}'}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding Nickname}" FontSize="13"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Text="{Binding DiffToTop, StringFormat='差榜首 {0:F1}'}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
