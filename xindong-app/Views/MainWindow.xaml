<Window x:Class="XinDong.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="薪动 XinDong"
        Width="1180" Height="780"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/xindong_icon_64.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- 日历格子：整格可点，悬浮浅灰底 -->
        <Style x:Key="CalendarCellButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5F5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 周 / 年胶囊 -->
        <Style x:Key="WeekChipButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBg" Background="Transparent" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBg" Property="Background" Value="#F2F2F7" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ChipBg" Property="Background" Value="#007AFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 月圆圈 -->
        <Style x:Key="MonthCircleButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CircleBg" Background="Transparent" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBg" Property="Background" Value="#F2F2F7" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="CircleBg" Property="Background" Value="#007AFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 年胶囊 -->
        <Style x:Key="YearChipButton" TargetType="Button" BasedOn="{StaticResource WeekChipButton}">
            <Setter Property="Padding" Value="18,0" />
        </Style>

        <!-- 设置页节假日月历格子 -->
        <Style x:Key="HolidayDayButton" TargetType="Button">
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E5E5EA" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#9CC7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <!-- 外层圆角 + 柔和弥散阴影 -->
        <Border CornerRadius="16" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.22" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ==================== 顶部标题栏 ==================== -->
                <Grid x:Name="TitleBar"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 红黄绿交通灯 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Button Style="{StaticResource TrafficLight}"
                                Background="#FF5F56"
                                ToolTip="老板键隐身（Alt + Z）"
                                Click="BossLight_Click" />
                        <Button Style="{StaticResource TrafficLight}"
                                Background="#FFBD2E"
                                Margin="8,0,0,0"
                                ToolTip="收进灵动岛"
                                Click="MinimizeLight_Click" />
                        <Button Style="{StaticResource TrafficLight}"
                                Background="#27C93F"
                                Margin="8,0,0,0"
                                ToolTip="开始 / 结束带薪摸鱼"
                                Click="SlackLight_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="薪动 XinDong" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}" />
                        <Border Width="1" Height="12" Background="#E5E5EA" Margin="10,0" />
                        <TextBlock Text="让每一秒都有价格" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="Alt + Z 老板键"
                               FontSize="11" Margin="0,0,20,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </Grid>

                <!-- ==================== 主体 ==================== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧导航 -->
                    <Border Background="{StaticResource NavBgBrush}" CornerRadius="0,0,0,16" Padding="14,18,14,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="11"
                                        Background="{StaticResource AccentBrush}">
                                    <TextBlock Text="薪" Foreground="White" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="薪动" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="反薅老板指挥中心" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                <RadioButton Style="{StaticResource NavRadio}"
                                             GroupName="nav"
                                             Content="💰 今日大屏"
                                             IsChecked="{Binding IsPageToday, Mode=OneWay}"
                                             Command="{Binding SetPageCommand}" CommandParameter="0" />
                                <RadioButton Style="{StaticResource NavRadio}"
                                             GroupName="nav"
                                             Content="📊 复盘看板"
                                             IsChecked="{Binding IsPageBoard, Mode=OneWay}"
                                             Command="{Binding SetPageCommand}" CommandParameter="1" />
                                <RadioButton Style="{StaticResource NavRadio}"
                                             GroupName="nav"
                                             Content="📖 血泪账本"
                                             IsChecked="{Binding IsPageLedger, Mode=OneWay}"
                                             Command="{Binding SetPageCommand}" CommandParameter="2" />
                                <RadioButton Style="{StaticResource NavRadio}"
                                             GroupName="nav"
                                             Content="🏆 排行"
                                             IsChecked="{Binding IsPageRank, Mode=OneWay}"
                                             Command="{Binding SetPageCommand}" CommandParameter="4" />
                                <RadioButton Style="{StaticResource NavRadio}"
                                             GroupName="nav"
                                             Content="⚙️ 设置"
                                             IsChecked="{Binding IsPageSettings, Mode=OneWay}"
                                             Command="{Binding SetPageCommand}" CommandParameter="3" />
                            </StackPanel>

                            <!-- 底部状态小结 -->
                            <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="今日工时" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WorkedDurationText}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="14" FontWeight="Bold" Margin="0,2,0,0"
                                               ToolTip="{Binding WorkedBreakdownText}" />
                                    <Border Height="1" Background="{StaticResource HairLineBrush}" Margin="0,9" />
                                    <TextBlock Text="{Binding SurvivalNetText}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Button Content="退出薪动" Click="Exit_Click"
                                            Style="{StaticResource GhostButton}"
                                            Height="30" Margin="0,10,0,0" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 右侧内容 -->
                    <Grid Grid.Column="1" Background="White">

                        <!-- ============ 页面 1：今日大屏 ============ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsPageToday, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="26,20,26,24">

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource H1}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="·" Margin="8,0" Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <CheckBox Content="🏖️ 今日休假（停止计费）"
                                                  Style="{StaticResource ChipCheckBox}"
                                                  IsChecked="{Binding IsTodayOff, Mode=TwoWay}"
                                                  Margin="0,0,10,0" />
                                        <Button Content="📌 收进灵动岛"
                                                Command="{Binding MinimizeToIslandCommand}"
                                                Style="{StaticResource GhostButton}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 实时大屏 -->
                                <Border Margin="0,16,0,0" CornerRadius="18" BorderThickness="1" Padding="24">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                                                    <Setter Property="Background" Value="#1C1C1E" />
                                                    <Setter Property="BorderBrush" Value="#FF453A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="今日已赚" FontSize="13"
                                                           Foreground="{Binding HeroSubTextBrush}" />
                                                <Border HorizontalAlignment="Right" CornerRadius="7"
                                                        Padding="9,3" Background="{Binding StatusSoftBrush}">
                                                    <TextBlock Text="{Binding IslandStateText}" FontSize="11"
                                                               FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                                                </Border>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="¥" FontSize="26" FontWeight="Bold"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{Binding EarnedBrush}"
                                                           VerticalAlignment="Bottom" Margin="0,0,6,7" />
                                                <TextBlock Text="{Binding EarnedNumberText}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="56" FontWeight="Bold"
                                                           Foreground="{Binding EarnedBrush}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding SecondSalaryText}" FontSize="12"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{Binding HeroSubTextBrush}" Margin="2,2,0,0" />

                                            <!-- 时薪模式：锁定金额 + 倒计时 + 进度条 -->
                                            <Grid Margin="0,16,0,0"
                                                  Visibility="{Binding IsHourly, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="锁定到手" FontSize="10"
                                                               Foreground="{Binding HeroSubTextBrush}" />
                                                    <TextBlock Text="{Binding LockedText}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{Binding HeroTextBrush}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="34,0,0,0">
                                                    <TextBlock Text="距下一半点 / 整点" FontSize="10"
                                                               Foreground="{Binding HeroSubTextBrush}" />
                                                    <TextBlock Text="{Binding CountdownText}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="22" FontWeight="Bold"
                                                               Foreground="{Binding EarnedBrush}" Margin="0,0,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="30,8,0,0">
                                                    <ProgressBar Value="{Binding CountdownPercent, Mode=OneWay}" Maximum="100"
                                                                 Height="6" Foreground="{Binding EarnedBrush}"
                                                                 Background="#33FFFFFF"
                                                                 Style="{StaticResource RoundedProgress}" />
                                                    <TextBlock Text="零头不满半点不计薪，别在 29 分的时候点下班"
                                                               FontSize="10" Margin="0,5,0,0"
                                                               Foreground="{Binding HeroSubTextBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,14,0,0">
                                                <TextBlock Text="{Binding RemainingWorkText}" FontSize="12"
                                                           Foreground="{Binding HeroSubTextBrush}" />
                                                <TextBlock Text="{Binding WorkedTimeText}" FontSize="12"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{Binding HeroSubTextBrush}"
                                                           ToolTip="{Binding WorkedBreakdownText}" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- 义务加班：红色呼吸光晕覆盖层（只画边框，不影响内容） -->
                                        <Border CornerRadius="18" BorderThickness="1.5"
                                                BorderBrush="#FF453A" IsHitTestVisible="False">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF453A" BlurRadius="30" ShadowDepth="0" Opacity="0.9" />
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="HeroBreath">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0.15" To="0.85"
                                                                                         Duration="0:0:0.85" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="HeroBreath" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 三张实时卡片 -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}" MinHeight="158">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🐟 带薪摸鱼" Style="{StaticResource H2}" />
                                                <TextBlock Text="你白嫖老板" FontSize="10" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding SlackingAmountText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="23" FontWeight="Bold"
                                                       Foreground="{StaticResource GreenBrush}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding SlackingTimeText}" Style="{StaticResource Caption}"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding SlackingBenefitText}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="158">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🩸 义务加班" Style="{StaticResource H2}" />
                                                <TextBlock Text="老板白嫖你" FontSize="10" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding OvertimeAmountText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="23" FontWeight="Bold"
                                                       Foreground="{StaticResource RedBrush}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding OvertimeTimeText}" Style="{StaticResource Caption}"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding OvertimeGoodsText}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding OvertimeQuoteText}" FontSize="10"
                                                       Foreground="{StaticResource RedBrush}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding OvertimeRateText}" Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource RedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource Card}" MinHeight="158">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🏠 生存回本线" Style="{StaticResource H2}"
                                                           ToolTip="今日净赚 = 今日已赚 − 生存成本 − 义务加班亏损 − 抹零损失" />
                                                <TextBlock Text="{Binding SurvivalNetText}" FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                            <ProgressBar Value="{Binding SurvivalPercent, Mode=OneWay}" Maximum="100"
                                                         Style="{StaticResource RoundedProgress}"
                                                         Foreground="{StaticResource GoldBrush}" Margin="0,12,0,0" />
                                            <TextBlock Text="{Binding SurvivalText}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 快捷操作 -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="快捷操作" Style="{StaticResource H2}" />
                                            <TextBlock Text="{Binding SlackingTypeName}" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="↩️ 手滑了 / 继续搬砖" Style="{StaticResource SuccessButton}"
                                                    Margin="0,0,8,8" Command="{Binding UndoOffDutyCommand}"
                                                    Visibility="{Binding IsOffDuty, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="🚨 老板夺命Call · 被迫营业" Style="{StaticResource DangerButton}"
                                                    Margin="0,0,8,8" Command="{Binding TriggerEmergencyCallCommand}"
                                                    Visibility="{Binding ShowEmergencyCallButton, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="🛑 终于放我走了" Style="{StaticResource DangerButton}"
                                                    Margin="0,0,8,8" Command="{Binding EndEmergencyCallCommand}"
                                                    Visibility="{Binding IsEmergencyCall, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="🚽 带薪拉屎" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,8" Command="{Binding StartSlackCommand}"
                                                    CommandParameter="Toilet" />
                                            <Button Content="📱 刷手机/水群" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,8" Command="{Binding StartSlackCommand}"
                                                    CommandParameter="Phone" />
                                            <Button Content="☕ 泡茶拿外卖" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,8" Command="{Binding StartSlackCommand}"
                                                    CommandParameter="Tea" />
                                            <Button Content="😶 发呆放空" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,8" Command="{Binding StartSlackCommand}"
                                                    CommandParameter="Daze" />
                                            <Button Content="✅ 结束摸鱼" Style="{StaticResource SuccessButton}"
                                                    Margin="0,0,8,8" Command="{Binding StopSlackCommand}"
                                                    Visibility="{Binding CanStopSlack, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="🏃 确认下班（防亏结算）" Style="{StaticResource DangerButton}"
                                                    Margin="0,0,8,8" Command="{Binding ClockOutCommand}"
                                                    Visibility="{Binding CanClockOut, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SalaryLockText}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource RedBrush}" Margin="2,2,0,0"
                                                   Visibility="{Binding IsMonthlySalaryLocked, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding EmergencyCallModeText}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource RedBrush}" Margin="2,4,0,0"
                                                   Visibility="{Binding IsEmergencyCall, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="提示：确认下班时，时薪模式若零头落在 20~29 分钟，会强制拦截并提示你还差多少能凑满半点。"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ 页面 2：复盘看板 ============ -->
                        <Grid Visibility="{Binding IsPageBoard, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="26,20,26,24">

                                    <!-- 一级标题 + 维度切换 -->
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding BoardDateTitle}" Style="{StaticResource H1}" FontSize="28" />
                                            <TextBlock Text="{Binding BoardSubtitle}" Style="{StaticResource Caption}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="{StaticResource NavBgBrush}" CornerRadius="9" Padding="3">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource SegRadio}" GroupName="view"
                                                                 Content="📅 日"
                                                                 IsChecked="{Binding IsViewDaily, Mode=OneWay}"
                                                                 Command="{Binding SetViewCommand}" CommandParameter="Daily" />
                                                    <RadioButton Style="{StaticResource SegRadio}" GroupName="view"
                                                                 Content="📊 周"
                                                                 IsChecked="{Binding IsViewWeekly, Mode=OneWay}"
                                                                 Command="{Binding SetViewCommand}" CommandParameter="Weekly" />
                                                    <RadioButton Style="{StaticResource SegRadio}" GroupName="view"
                                                                 Content="📈 月"
                                                                 IsChecked="{Binding IsViewMonthly, Mode=OneWay}"
                                                                 Command="{Binding SetViewCommand}" CommandParameter="Monthly" />
                                                    <RadioButton Style="{StaticResource SegRadio}" GroupName="view"
                                                                 Content="🗓️ 年"
                                                                 IsChecked="{Binding IsViewYearly, Mode=OneWay}"
                                                                 Command="{Binding SetViewCommand}" CommandParameter="Yearly" />
                                                </StackPanel>
                                            </Border>
                                            <Button Content="📤 导出全部"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="10,0,0,0" Click="ExportCsv_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 日视图：单周日历 / 整月日历 -->
                                    <StackPanel Visibility="{Binding IsViewDaily, Converter={StaticResource BoolToVis}}"
                                                Margin="0,14,0,0">

                                        <!-- 图例 -->
                                        <Border Background="#F5F5F7" CornerRadius="10" Padding="12,8"
                                                Visibility="{Binding ShowCalendarLegend, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <WrapPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                        <Ellipse Width="7" Height="7" Fill="#007AFF" VerticalAlignment="Center" />
                                                        <TextBlock Text="已反薅 / 满勤" FontSize="10" Margin="5,0,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                        <Ellipse Width="7" Height="7" Fill="#FF9F0A" VerticalAlignment="Center" />
                                                        <TextBlock Text="被白嫖（加班 / 抹零）" FontSize="10" Margin="5,0,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="#C7C7CC" VerticalAlignment="Center" />
                                                        <TextBlock Text="摸鱼 / 节假日" FontSize="10" Margin="5,0,0,0"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </WrapPanel>

                                                <Button Content="×" Command="{Binding CloseLegendCommand}"
                                                        HorizontalAlignment="Right" Width="22" Height="22"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" />
                                            </Grid>
                                        </Border>

                                        <!-- 图例关闭后的恢复入口 -->
                                        <Button Content="ⓘ 显示图例" Command="{Binding ShowLegendCommand}"
                                                HorizontalAlignment="Left" Height="26" Padding="8,0" Margin="0,6,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowCalendarLegend}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- 月份标题 + 月份翻页 -->
                                        <Grid Margin="0,12,0,4">
                                            <Button Content="‹" Command="{Binding PrevCalendarMonthCommand}"
                                                    Style="{StaticResource GhostButton}" Width="30" Height="30"
                                                    Padding="0" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding CalendarTitle}" Style="{StaticResource H2}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Button Content="›" Command="{Binding NextCalendarMonthCommand}"
                                                    Style="{StaticResource GhostButton}" Width="30" Height="30"
                                                    Padding="0" HorizontalAlignment="Right" />
                                        </Grid>

                                        <!-- 星期表头 -->
                                        <UniformGrid Columns="7" Margin="0,0,0,2">
                                            <TextBlock Text="一" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="二" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="三" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="四" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="五" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="六" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="日" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                        </UniformGrid>

                                        <!-- 日历格子（7 或 42 格共用同一模板） -->
                                        <Border Style="{StaticResource Card}" Padding="8">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding CalendarDays}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="7" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource CalendarCellButton}"
                                                                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Date}">
                                                                <Grid Height="80">
                                                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                        <Border x:Name="SelBg" Width="30" Height="30"
                                                                                CornerRadius="15" Background="Transparent">
                                                                            <TextBlock x:Name="DayText" Text="{Binding DayText}"
                                                                                       FontSize="13" HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" Foreground="#1C1C1E" />
                                                                        </Border>

                                                                        <StackPanel Orientation="Horizontal" Height="8"
                                                                                    HorizontalAlignment="Center" Margin="0,2,0,0">
                                                                            <Ellipse Width="5" Height="5" Fill="#007AFF" Margin="1,0"
                                                                                     Visibility="{Binding BlueDot, Converter={StaticResource BoolToVis}}" />
                                                                            <Ellipse Width="5" Height="5" Fill="#FF9F0A" Margin="1,0"
                                                                                     Visibility="{Binding OrangeDot, Converter={StaticResource BoolToVis}}" />
                                                                            <Ellipse Width="5" Height="5" Fill="#C7C7CC" Margin="1,0"
                                                                                     Visibility="{Binding GrayDot, Converter={StaticResource BoolToVis}}" />
                                                                        </StackPanel>

                                                                        <TextBlock x:Name="AmountText" Text="{Binding AmountText}"
                                                                                   FontSize="9" HorizontalAlignment="Center"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                                   Margin="0,1,0,0" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsOtherMonth}" Value="True">
                                                                    <Setter TargetName="DayText" Property="Foreground" Value="#C7C7CC" />
                                                                    <Setter TargetName="AmountText" Property="Foreground" Value="#C7C7CC" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                                    <Setter TargetName="DayText" Property="Foreground" Value="#C7C7CC" />
                                                                    <Setter TargetName="AmountText" Property="Foreground" Value="#C7C7CC" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter TargetName="DayText" Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="SelBg" Property="Background" Value="#007AFF" />
                                                                    <Setter TargetName="DayText" Property="Foreground" Value="White" />
                                                                    <Setter TargetName="DayText" Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- 上一周 / 展开收起 / 下一周 -->
                                                <Grid Margin="0,4,0,0">
                                                    <Button Content="‹ 上一周" Command="{Binding PrevWeekCommand}"
                                                            Style="{StaticResource GhostButton}" Height="28" Padding="10,0"
                                                            HorizontalAlignment="Left" />
                                                    <Button Content="{Binding CalendarToggleGlyph}" Command="{Binding ToggleCalendarCommand}"
                                                            Width="44" Height="28" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            FontSize="14" Cursor="Hand"
                                                            Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <Button Content="下一周 ›" Command="{Binding NextWeekCommand}"
                                                            Style="{StaticResource GhostButton}" Height="28" Padding="10,0"
                                                            HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 日视图底部：班次 + 对冲 -->
                                        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DayShiftText}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DaySummaryText}" FontSize="12"
                                                           Margin="0,6,0,0" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 周视图：第一周 ~ 第六周 -->
                                    <StackPanel Visibility="{Binding IsViewWeekly, Converter={StaticResource BoolToVis}}"
                                                Margin="0,16,0,0">
                                        <TextBlock Text="选择周次" Style="{StaticResource Caption}" Margin="2,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding WeekChips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource WeekChipButton}"
                                                            Command="{Binding DataContext.SelectWeekCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 月视图：1~12 月圆圈 -->
                                    <StackPanel Visibility="{Binding IsViewMonthly, Converter={StaticResource BoolToVis}}"
                                                Margin="0,16,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Button Content="‹" Command="{Binding PrevYearCommand}"
                                                    Style="{StaticResource GhostButton}" Width="30" Height="30"
                                                    Padding="0" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding BoardYearLabel}" Style="{StaticResource H2}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Button Content="›" Command="{Binding NextYearCommand}"
                                                    Style="{StaticResource GhostButton}" Width="30" Height="30"
                                                    Padding="0" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding MonthChips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="12" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource MonthCircleButton}"
                                                            Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 年视图：近年份胶囊 -->
                                    <StackPanel Visibility="{Binding IsViewYearly, Converter={StaticResource BoolToVis}}"
                                                Margin="0,16,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Button Content="‹" Command="{Binding PrevYearCommand}"
                                                    Style="{StaticResource GhostButton}" Width="30" Height="30"
                                                    Padding="0" HorizontalAlignment="Left" />
                                            <TextBlock Text="选择年份" Style="{StaticResource H2}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Button Content="›" Command="{Binding NextYearCommand}"
                                                    Style="{StaticResource GhostButton}" Width="30" Height="30"
                                                    Padding="0" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding YearChips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource YearChipButton}"
                                                            Command="{Binding DataContext.SelectYearCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 熔断警报 -->
                                    <Border Background="#FFF1F0" BorderBrush="{StaticResource RedBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0"
                                            Visibility="{Binding ShowBoardAlert, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BoardAlertText}" Foreground="#B3261E"
                                                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding BoardAlertLimitText}" Foreground="#B3261E"
                                                       FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 12 宫格 -->
                                    <TextBlock Text="义务加班按设置倍率计算 · 纯利润 = 实得 − 生存线 × 出勤天数"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               HorizontalAlignment="Right" Margin="0,10,2,0" />
                                    <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="10">
                                        <ItemsControl ItemsSource="{Binding BoardMetrics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" Rows="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="88">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding ValueText}"
                                                                       FontSize="26" FontWeight="Bold"
                                                                       FontFamily="Consolas, Microsoft YaHei UI"
                                                                       Foreground="{Binding ValueBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       Foreground="{Binding LabelBrush}"
                                                                       Margin="0,6,0,0" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- 身价暴跌：固定日薪被加班摊薄后的实际时薪 -->
                                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.4*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="今日当前实际时薪" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding CurrentActualHourlyText}" FontSize="24"
                                                           FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource RedBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="今日身价暴跌" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding HourlyDepreciationText}" FontSize="20"
                                                           FontWeight="Bold" Foreground="{StaticResource RedBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding HourlyDepreciationHint}"
                                                       Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>

                                    <!-- 周 / 月 / 年底部：统计时间 + 明细入口 -->
                                    <Grid Margin="0,12,0,0"
                                          Visibility="{Binding IsViewPeriod, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding BoardUpdatedText}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="查看明细账本 >" Command="{Binding ToggleDetailCommand}"
                                                Style="{StaticResource GhostButton}" Height="32"
                                                HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- 更多分析（保留旧功能） -->
                                    <Grid Margin="0,16,0,0">
                                        <TextBlock Text="更多分析" Style="{StaticResource H2}" />
                                        <Button Content="展开 / 收起" Command="{Binding ToggleAnalysisCommand}"
                                                Style="{StaticResource GhostButton}" Height="30" Padding="12,0"
                                                HorizontalAlignment="Right" />
                                    </Grid>

                                    <StackPanel Visibility="{Binding IsAnalysisExpanded, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Background="#FAFAFC">
                                            <StackPanel>
                                                <TextBlock Text="牛马盈亏对冲净值盘" Style="{StaticResource H2}" />
                                                <TextBlock Text="{Binding BoardHeadline}" FontSize="20" FontWeight="Bold"
                                                           Margin="0,8,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNetPositive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B8860B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsNetNegative}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C62828" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding BoardFormulaText}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="12" Margin="0,6,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding BoardDaysText}" Style="{StaticResource Caption}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="🐟 摸鱼姿势成分分析" Style="{StaticResource H2}" />
                                                    <TextBlock Text="按白嫖金额占比" FontSize="11" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Slices}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="92" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                           VerticalAlignment="Center" />
                                                                <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                                                                             Style="{StaticResource RoundedProgress}"
                                                                             VerticalAlignment="Center" Margin="12,0" />
                                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding PercentText}" FontSize="12"
                                                                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                                    <TextBlock Text="{Binding AmountText}" FontSize="10"
                                                                               FontFamily="{StaticResource MonoFont}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="{Binding SlicesEmptyText}" Margin="0,10,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSlices}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Border Height="10" Background="Transparent" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 明细抽屉 -->
                            <Border Width="560" Margin="0,72,18,18" HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch" Background="White" CornerRadius="16"
                                    Panel.ZIndex="20"
                                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.22" Color="#000000" />
                                </Border.Effect>

                                <Grid Margin="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="明细账本" Style="{StaticResource H2}" />
                                            <TextBlock Text="{Binding DetailPeriodText}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Content="×" Command="{Binding CloseDetailCommand}"
                                                HorizontalAlignment="Right" Width="28" Height="28"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,12,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="日期" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="1" Text="实得" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="摸鱼" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="3" Text="加班" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="4" Text="抹零" Style="{StaticResource Caption}" />
                                    </Grid>

                                    <ListBox Grid.Row="2" ItemsSource="{Binding DetailRecords}"
                                             BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource HairLineBrush}" BorderThickness="0,0,0,1"
                                                        Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Date}" FontSize="11"
                                                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding NormalDisplay}" FontSize="11"
                                                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding SlackingDisplay}" FontSize="11"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding OvertimeDisplay}" FontSize="11"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding RoundingDisplay}" FontSize="11"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Grid.Row="2" Text="当前周期还没有账本记录。"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDetailRecords}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Grid Grid.Row="3" Margin="0,10,0,0">
                                        <Button Content="📤 导出当前周期 CSV" Click="ExportRangeCsv_Click"
