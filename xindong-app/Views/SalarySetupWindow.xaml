<Window x:Class="XinDong.Views.SalarySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置薪资"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Margin="18" CornerRadius="18" Background="White" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.24" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="👋 先设置你的薪资" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="首次使用只需要填这两项，之后可以随时在设置里修改。"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0" />

            <TextBlock Text="计薪方式" Style="{StaticResource Caption}" Margin="2,16,0,5" />
            <ComboBox x:Name="ModeCombo" Style="{StaticResource InputCombo}"
                      SelectionChanged="ModeCombo_SelectionChanged">
                <ComboBoxItem Content="月薪模式" IsSelected="True" />
                <ComboBoxItem Content="时薪模式" />
            </ComboBox>

            <TextBlock x:Name="AmountLabel" Text="月薪金额（元 / 月）"
                       Style="{StaticResource Caption}" Margin="2,12,0,5" />
            <TextBox x:Name="AmountBox" Style="{StaticResource InputBox}" />

            <TextBlock Text="只保存在本机，不会联网上传。"
                       Style="{StaticResource Caption}" Margin="2,7,0,0" />
            <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{StaticResource RedBrush}"
                       Margin="2,7,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="稍后设置" Height="36" MinWidth="88"
                        Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Content="开始使用" Height="36" MinWidth="110" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
